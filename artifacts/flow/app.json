{
  "expo": {
    "name": "Flow — Money Journal",
    "slug": "flow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/flow-icon.png",
    "scheme": "flow",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#eaf4fc",
      "resizeMode": "contain"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/23bfd21a-9dd8-4ecb-9934-e5364e9e759a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.naluapp.flow"
    },
    "android": {
      "package": "com.naluapp.flow",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/flow-icon.png",
        "backgroundColor": "#10366b"
      }
    },
    "web": {
      "favicon": "./assets/images/flow-icon.png",
      "name": "Flow — Money Journal",
      "shortName": "Flow",
      "themeColor": "#10366b",
      "backgroundColor": "#eaf4fc"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-updates"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "23bfd21a-9dd8-4ecb-9934-e5364e9e759a"
      }
    },
    "owner": "nalu-app"
  }
}
